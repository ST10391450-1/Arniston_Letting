<link rel="stylesheet"
      href="~/css/nav.css"
      asp-append-version="true" />

<header class="site-header">

    <div class="brand">

        <div class="brand-logo">
            ↗
        </div>

        <div class="brand-name">
            Arniston Holiday Letting
        </div>

    </div>

    <div class="header-title">
        @ViewData["Title"]
    </div>

    <div class="header-right">

        @if (ViewData["Title"]?.ToString() != "Admin Dashboard" &&
             ViewData["NoNav"]?.ToString() != "true")
        {
            <a href="/AdminDashboard"
               class="return-admin">
                Return To Admin
            </a>
        }

        <div class="header-date">

            <strong>Today's Date:</strong>

            <span>
                @DateTime.Now.ToString("dd/MM/yyyy")
            </span>

        </div>

    </div>

</header>

<aside class="sidebar">

    <nav class="main-navigation" aria-label="Main navigation">

        <div class="nav-item">
            <a href="/AdminBookings">
                Bookings
            </a>
        </div>

        <div class="nav-item">
            <a href="/AdminProperties">
                Properties
            </a>
        </div>

        <div class="nav-item">
            <a href="/AdminOwners">
                Owners
            </a>
        </div>

        <div class="nav-item">
            <a href="/AdminCleaner">
                Cleaners
            </a>
        </div>

        <div class="nav-item nav-task">
            <a href="/AdminTasks">
                Tasks
            </a>
        </div>

        <div class="nav-item">
            <a href="/AdminBreakages">
                Breakages
            </a>
        </div>

        <div class="nav-item">
            <a href="/AdminNotifications">
                Notifications
            </a>
        </div>

        <div class="nav-item">
            <a href="/AdminReports">
                Reports
            </a>
        </div>

    </nav>

    <div class="sidebar-bottom">

        <form method="post" asp-page="/Logout" style="margin:0">
            <button type="submit" class="logout-button" style="border:0;cursor:pointer;font:inherit;width:100%">
                LOG OUT
            </button>
        </form>

    </div>

</aside>