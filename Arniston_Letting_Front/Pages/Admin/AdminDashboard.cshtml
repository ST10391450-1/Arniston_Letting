@page "/AdminDashboard"
@model Arniston_Letting_Front.Pages.Admin.AdminDashboardModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="crud-page">

    @if (!Model.ApiAvailable)
    {
        <div class="alert alert-error">
            Could not reach the Arniston Letting API. Make sure the API project is running
            and that <code>ApiSettings:BaseUrl</code> in appsettings.json is correct.
        </div>
    }

    <div class="stat-grid">
        <div class="stat-card"><span>Total bookings</span><strong>@Model.Dashboard.TotalBookings</strong></div>
        <div class="stat-card"><span>Properties</span><strong>@Model.Dashboard.TotalProperties</strong></div>
        <div class="stat-card"><span>Owners</span><strong>@Model.Dashboard.TotalOwners</strong></div>
        <div class="stat-card"><span>Cleaners</span><strong>@Model.Dashboard.TotalCleaners</strong></div>
        <div class="stat-card"><span>Pending tasks</span><strong>@Model.Dashboard.PendingTasks</strong></div>
        <div class="stat-card"><span>Open breakages</span><strong>@Model.Dashboard.OpenBreakages</strong></div>
        <div class="stat-card"><span>Pending notifications</span><strong>@Model.Dashboard.PendingNotifications</strong></div>
    </div>

    <div class="crud-panel" style="margin-bottom:20px">
        <h2>Nearest confirmed bookings</h2>
        <div class="crud-table-wrap" style="margin:0">
            <table class="crud-table">
                <thead>
                    <tr><th>Accommodation</th><th>Booker</th><th>Check in</th><th>Check out</th><th>Rate</th></tr>
                </thead>
                <tbody>
                    @if (Model.UpcomingBookings.Any())
                    {
                        foreach (var booking in Model.UpcomingBookings)
                        {
                            <tr>
                                <td>@booking.PropertyName</td>
                                <td>@booking.BookerName</td>
                                <td>@booking.CheckIn.ToString("yyyy-MM-dd")</td>
                                <td>@booking.CheckOut.ToString("yyyy-MM-dd")</td>
                                <td>@("R" + booking.Rate.ToString("N2"))</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="5">No upcoming confirmed bookings.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="crud-grid-2">
        <div class="crud-panel">
            <h2>Open breakages</h2>
            <div class="crud-table-wrap" style="margin:0">
                <table class="crud-table">
                    <thead><tr><th>Location</th><th>Reported by</th><th>Date</th></tr></thead>
                    <tbody>
                        @if (Model.OpenBreakages.Any())
                        {
                            foreach (var breakage in Model.OpenBreakages)
                            {
                                <tr>
                                    <td>@breakage.LocationName</td>
                                    <td>@breakage.ReportedBy</td>
                                    <td>@breakage.Date.ToString("yyyy-MM-dd")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="3">No open breakages.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="crud-panel">
            <h2>Houses to be cleaned today</h2>
            <div class="crud-table-wrap" style="margin:0">
                <table class="crud-table">
                    <thead><tr><th>Location</th><th>Cleaner</th><th>Time</th><th>Status</th></tr></thead>
                    <tbody>
                        @if (Model.TodaysCleanings.Any())
                        {
                            foreach (var task in Model.TodaysCleanings)
                            {
                                <tr>
                                    <td>@task.LocationName</td>
                                    <td>@task.CleanerName</td>
                                    <td>@(task.Time.ToString(@"hh\:mm"))</td>
                                    <td>
                                        <span class="badge @(task.Completed ? "badge-green" : "badge-amber")">
                                            @(task.Completed ? "Completed" : "Pending")
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="4">No cleaning tasks for today.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
