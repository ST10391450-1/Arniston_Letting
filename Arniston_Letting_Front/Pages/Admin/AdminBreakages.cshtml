@page "/AdminBreakages"
@model Arniston_Letting_Front.Pages.Admin.AdminBreakagesModel

@{
ViewData["Title"] = "Breakages";
}

<div class="crud-page">
<div class="crud-header">

    <div>
        <div class="crud-title">Breakages</div>
        <div class="crud-subtitle">Manage reported property breakages and repairs</div>
    </div>

    <form method="get" class="crud-search">

        <input type="text"
               name="Search"
               value="@Model.Search"
               placeholder="Search breakages..." />

        <button type="submit"
                class="btn btn-primary">
            Search
        </button>

        @if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            <a class="btn btn-muted"
               asp-page="/Admin/AdminBreakages">
                Clear
            </a>
        }

    </form>

</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-success">
        @Model.Message
    </div>
}

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-error">
        @Model.Error
    </div>
}

<div class="crud-card">

    <div class="crud-card-header">

        <div>
            <h2>Breakage List</h2>
            <span>Reported property issues and their current status</span>
        </div>

    </div>

    <div class="crud-table-wrap">

        <table class="crud-table">

            <thead>
                <tr>
                    <th class="col-id">ID</th>
                    <th>Property</th>
                    <th>Date</th>
                    <th>Time</th>
                    <th>Reported by</th>
                    <th>Resolved</th>
                    <th class="col-actions">Actions</th>
                </tr>
            </thead>

            <tbody>

                @if (Model.Items.Any())
                {
                    foreach (var item in Model.Items)
                    {
                        <tr class="@(Model.EditId == item.BreakageId ? "selected" : "")">

                            <td class="booking-id">
                                @item.BreakageId
                            </td>

                            <td class="booking-property">
                                @item.LocationName
                            </td>

                            <td>
                                @item.Date.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @item.Time.ToString(@"hh\:mm")
                            </td>

                            <td>
                                @item.ReportedBy
                            </td>

                            <td>

                                @if (item.Resolved)
                                {
                                    <span class="dashboard-status status-completed">
                                        Resolved
                                    </span>
                                }
                                else
                                {
                                    <span class="dashboard-status status-pending">
                                        Open
                                    </span>
                                }

                            </td>

                            <td>

                                <div class="crud-actions">

                                    <a class="btn btn-small btn-primary"
                                       asp-page="/Admin/AdminBreakages"
                                       asp-route-EditId="@item.BreakageId"
                                       asp-route-Search="@Model.Search">
                                        Edit
                                    </a>

                                    <form method="post"
                                          asp-page-handler="Delete"
                                          asp-route-id="@item.BreakageId"
                                          asp-route-Search="@Model.Search"
                                          onsubmit="return confirm('Delete this breakage?');">

                                        <button type="submit"
                                                class="btn btn-small btn-danger">
                                            Delete
                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7"
                            class="empty-state">
                            No breakages found.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

<div class="crud-panel">

    <div class="crud-panel-header">

        <div>

            <h2>
                @(Model.EditId.HasValue
                    ? $"Edit breakage #{Model.EditId}"
                    : "Add new breakage")
            </h2>

            <span>
                @(Model.EditId.HasValue
                    ? "Update the breakage details below"
                    : "Enter the details for the reported breakage")
            </span>

        </div>

    </div>

    <form method="post"
          asp-page-handler="Save"
          asp-route-Search="@Model.Search">

        <input type="hidden"
               name="EditId"
               value="@Model.EditId" />

        <div asp-validation-summary="ModelOnly"
             class="field-error">
        </div>

        <div class="crud-form">

            <div class="crud-field">

                <label asp-for="Input.LocationId">
                    Property
                </label>

                <select asp-for="Input.LocationId"
                        asp-items="Model.PropertyOptions">

                    <option value="">
                        -- Select property --
                    </option>

                </select>

                <span asp-validation-for="Input.LocationId"
                      class="field-error">
                </span>

            </div>

            <div class="crud-field">

                <label asp-for="Input.BookingId">
                    Booking
                </label>

                <select asp-for="Input.BookingId"
                        asp-items="Model.BookingOptions">

                    <option value="">
                        None
                    </option>

                </select>

                <span asp-validation-for="Input.BookingId"
                      class="field-error">
                </span>

                <div class="field-hint">
                    Optional booking reference
                </div>

            </div>

            <div class="crud-field">

                <label asp-for="Input.Date">
                    Date
                </label>

                <input asp-for="Input.Date"
                       type="date" />

                <span asp-validation-for="Input.Date"
                      class="field-error">
                </span>

            </div>

            <div class="crud-field">

                <label asp-for="Input.Time">
                    Time
                </label>

                <input asp-for="Input.Time"
                       type="time" />

                <span asp-validation-for="Input.Time"
                      class="field-error">
                </span>

            </div>

            <div class="crud-field">

                <label asp-for="Input.ReportedBy">
                    Reported by
                </label>

                <input asp-for="Input.ReportedBy"
                       type="text"
                       placeholder="Enter name" />

                <span asp-validation-for="Input.ReportedBy"
                      class="field-error">
                </span>

            </div>

            <div class="crud-field check">

                <input asp-for="Input.Resolved"
                       type="checkbox" />

                <label asp-for="Input.Resolved">
                    Resolved
                </label>

            </div>

            <div class="crud-field wide">

                <label asp-for="Input.Notes">
                    Notes
                </label>

                <textarea asp-for="Input.Notes"
                          rows="4"
                          placeholder="Describe the breakage or required repair"></textarea>

                <span asp-validation-for="Input.Notes"
                      class="field-error">
                </span>

            </div>

        </div>

        <div class="crud-buttons">

            <button type="submit"
                    class="btn btn-primary">
                @(Model.EditId.HasValue ? "Update Breakage" : "Create Breakage")
            </button>

            @if (Model.EditId.HasValue)
            {
                <a class="btn btn-muted"
                   asp-page="/Admin/AdminBreakages"
                   asp-route-Search="@Model.Search">
                    Cancel
                </a>
            }

        </div>

    </form>

</div>

</div>

@section Scripts { <partial name="_ValidationScriptsPartial" />
}
