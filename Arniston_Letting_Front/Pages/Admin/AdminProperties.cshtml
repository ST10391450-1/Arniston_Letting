@page "/AdminProperties"
@model Arniston_Letting_Front.Pages.Admin.AdminPropertiesModel

@{
    ViewData["Title"] = "Properties";
}

<div class="crud-page">

    <div class="crud-header">
        <div class="crud-title">Properties</div>

        <form method="get" class="crud-search">
            <input type="text" name="Search" value="@Model.Search" placeholder="Search..." />
            <button type="submit" class="btn btn-primary">Search</button>
            @if (!string.IsNullOrWhiteSpace(Model.Search))
            {
                <a class="btn btn-muted" asp-page="/Admin/AdminProperties">Clear</a>
            }
        </form>
    </div>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-success">@Model.Message</div>
    }

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert alert-error">@Model.Error</div>
    }

    <div class="crud-table-wrap">
        <table class="crud-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Property</th>
                    <th>Owner</th>
                    <th>Bedrooms</th>
                    <th>Sleeps</th>
                    <th>Rate / night</th>
                    <th>Occupied</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    foreach (var item in Model.Items)
                    {
                        <tr class="@(Model.EditId == item.PropertyId ? "selected" : "")">
                            <td>@(item.PropertyId)</td>
                            <td>@(item.PropertyName)</td>
                            <td>@(item.OwnerName)</td>
                            <td>@(item.Bedrooms)</td>
                            <td>@(item.Sleeps)</td>
                            <td>@("R" + item.RatePerNight.ToString("N2"))</td>
                            <td>@(item.Occupied ? "Yes" : "No")</td>
                            <td>
                                <div class="crud-actions">
                                    <a class="btn btn-small btn-primary" asp-page="/Admin/AdminProperties" asp-route-EditId="@item.PropertyId" asp-route-Search="@Model.Search">Edit</a>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@item.PropertyId" asp-route-Search="@Model.Search"
                                          onsubmit="return confirm('Delete this property?');">
                                        <button type="submit" class="btn btn-small btn-danger">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8">No properties found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="crud-panel">
        <h2>@(Model.EditId.HasValue ? $"Edit property #{Model.EditId}" : "Add new property")</h2>

        <form method="post" asp-page-handler="Save" asp-route-Search="@Model.Search">
            <input type="hidden" name="EditId" value="@Model.EditId" />

            <div asp-validation-summary="ModelOnly" class="field-error"></div>

            <div class="crud-form">
                <div class="crud-field">
                    <label asp-for="Input.PropertyName">Property name</label>
                    <input asp-for="Input.PropertyName" type="text" />
                    <span asp-validation-for="Input.PropertyName" class="field-error"></span>
                </div>
                <div class="crud-field">
                    <label asp-for="Input.Address">Address</label>
                    <input asp-for="Input.Address" type="text" />
                    <span asp-validation-for="Input.Address" class="field-error"></span>
                </div>
                <div class="crud-field">
                    <label asp-for="Input.OwnerId">Owner</label>
                    <select asp-for="Input.OwnerId" asp-items="Model.OwnerOptions">
                        <option value="">-- Select --</option>
                    </select>
                    <span asp-validation-for="Input.OwnerId" class="field-error"></span>
                </div>
                <div class="crud-field">
                    <label asp-for="Input.Bedrooms">Bedrooms</label>
                    <input asp-for="Input.Bedrooms" type="number" min="0" />
                    <span asp-validation-for="Input.Bedrooms" class="field-error"></span>
                </div>
                <div class="crud-field">
                    <label asp-for="Input.Sleeps">Sleeps</label>
                    <input asp-for="Input.Sleeps" type="number" min="0" />
                    <span asp-validation-for="Input.Sleeps" class="field-error"></span>
                </div>
                <div class="crud-field">
                    <label asp-for="Input.RatePerNight">Rate per night (R)</label>
                    <input asp-for="Input.RatePerNight" type="number" step="0.01" min="0" />
                    <span asp-validation-for="Input.RatePerNight" class="field-error"></span>
                </div>
                <div class="crud-field check">
                    <input asp-for="Input.Occupied" type="checkbox" />
                    <label asp-for="Input.Occupied">Occupied</label>
                </div>
                <div class="crud-field">
                    <label asp-for="Input.OccupiedUntil">Occupied until</label>
                    <input asp-for="Input.OccupiedUntil" type="date" />
                    <span asp-validation-for="Input.OccupiedUntil" class="field-error"></span>
                </div>
                <div class="crud-field check">
                    <input asp-for="Input.Parking" type="checkbox" />
                    <label asp-for="Input.Parking">Parking</label>
                </div>
                <div class="crud-field check">
                    <input asp-for="Input.Pool" type="checkbox" />
                    <label asp-for="Input.Pool">Pool</label>
                </div>
                <div class="crud-field wide">
                    <label asp-for="Input.Description">Description</label>
                    <textarea asp-for="Input.Description" rows="3"></textarea>
                    <span asp-validation-for="Input.Description" class="field-error"></span>
                </div>
            </div>

            <div class="crud-buttons">
                <button type="submit" class="btn btn-primary">@(Model.EditId.HasValue ? "Update" : "Create")</button>
                @if (Model.EditId.HasValue)
                {
                    <a class="btn btn-muted" asp-page="/Admin/AdminProperties" asp-route-Search="@Model.Search">Cancel</a>
                }
            </div>
        </form>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
