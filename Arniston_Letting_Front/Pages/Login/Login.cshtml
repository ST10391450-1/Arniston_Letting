@page "/Login"
@model Arniston_Letting_Front.Pages.Login.LoginModel

@{
    ViewData["Title"] = "Login";
    ViewData["NoNav"] = true;
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/login.css"
          asp-append-version="true" />
}

<div class="login-container">

    <div class="login-card">

        <h1>Login</h1>

        <form method="post">

            <div asp-validation-summary="All"></div>

            <div class="form-group">

                <label asp-for="LoginRequest.Email">
                    Email
                </label>

                <input asp-for="LoginRequest.Email"
                       type="email"
                       placeholder="Enter your email" />

                <span asp-validation-for="LoginRequest.Email"></span>

            </div>

            <div class="form-group">

                <label asp-for="LoginRequest.Password">
                    Password
                </label>

                <input asp-for="LoginRequest.Password"
                       type="password"
                       placeholder="Enter your password" />

                <span asp-validation-for="LoginRequest.Password"></span>

            </div>

            <button type="submit"
                    class="login-button">
                Login
            </button>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}