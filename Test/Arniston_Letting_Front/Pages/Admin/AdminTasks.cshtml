@page "/AdminTasks"
@model Arniston_Letting_Front.Pages.Admin.AdminTasksModel

@{
ViewData["Title"] = "Cleaning Tasks";
}

<div class="crud-page">
<div class="crud-header">

    <div>
        <div class="crud-title">Cleaning Tasks</div>
        <div class="crud-subtitle">Schedule and manage property cleaning tasks</div>
    </div>

    <form method="get"
          class="crud-search">

        <input type="text"
               name="Search"
               value="@Model.Search"
               placeholder="Search cleaning tasks..." />

        <button type="submit"
                class="btn btn-primary">
            Search
        </button>

        @if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            <a class="btn btn-muted"
               asp-page="/Admin/AdminTasks">
                Clear
            </a>
        }

    </form>

</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-success">
        @Model.Message
    </div>
}

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-error">
        @Model.Error
    </div>
}

<div class="crud-card">

    <div class="crud-card-header">

        <div>
            <h2>Cleaning Task List</h2>
            <span>Scheduled cleaning work and completion status</span>
        </div>

    </div>

    <div class="crud-table-wrap">

        <table class="crud-table">

            <thead>
                <tr>
                    <th class="col-id">ID</th>
                    <th>Cleaner</th>
                    <th>Property</th>
                    <th>Date</th>
                    <th>Time</th>
                    <th>Status</th>
                    <th class="col-actions">Actions</th>
                </tr>
            </thead>

            <tbody>

                @if (Model.Items.Any())
                {
                    foreach (var item in Model.Items)
                    {
                        <tr class="@(Model.EditId == item.CleanerTaskId ? "selected" : "")">

                            <td class="booking-id">
                                @item.CleanerTaskId
                            </td>

                            <td class="booking-property">
                                @item.CleanerName
                            </td>

                            <td>
                                @item.LocationName
                            </td>

                            <td>
                                @item.Date.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @item.Time.ToString(@"hh\:mm")
                            </td>

                            <td>

                                @if (item.Completed)
                                {
                                    <span class="dashboard-status status-completed">
                                        Completed
                                    </span>
                                }
                                else
                                {
                                    <span class="dashboard-status status-pending">
                                        Pending
                                    </span>
                                }

                            </td>

                            <td>

                                <div class="crud-actions">

                                    <a class="btn btn-small btn-primary"
                                       asp-page="/Admin/AdminTasks"
                                       asp-route-EditId="@item.CleanerTaskId"
                                       asp-route-Search="@Model.Search">
                                        Edit
                                    </a>

                                    <form method="post"
                                          asp-page-handler="Delete"
                                          asp-route-id="@item.CleanerTaskId"
                                          asp-route-Search="@Model.Search"
                                          onsubmit="return confirm('Delete this cleaning task?');">

                                        <button type="submit"
                                                class="btn btn-small btn-danger">
                                            Delete
                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7"
                            class="empty-state">
                            No cleaning tasks found.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

<div class="crud-panel">

    <div class="crud-panel-header">

        <div>

            <h2>
                @(Model.EditId.HasValue
                    ? $"Edit task #{Model.EditId}"
                    : "Add new cleaning task")
            </h2>

            <span>
                @(Model.EditId.HasValue
                    ? "Update the cleaning task information below"
                    : "Schedule a new property cleaning task")
            </span>

        </div>

    </div>

    <form method="post"
          asp-page-handler="Save"
          asp-route-Search="@Model.Search">

        <input type="hidden"
               name="EditId"
               value="@Model.EditId" />

        <div asp-validation-summary="ModelOnly"
             class="field-error">
        </div>

        <div class="crud-form">

            <div class="crud-field">

                <label asp-for="Input.CleanerId">
                    Cleaner
                </label>

                <select asp-for="Input.CleanerId"
                        asp-items="Model.CleanerOptions">

                    <option value="">
                        -- Select cleaner --
                    </option>

                </select>

                <span asp-validation-for="Input.CleanerId"
                      class="field-error">
                </span>

            </div>

            <div class="crud-field">

                <label asp-for="Input.LocationId">
                    Property
                </label>

                <select asp-for="Input.LocationId"
                        asp-items="Model.PropertyOptions">

                    <option value="">
                        -- Select property --
                    </option>

                </select>

                <span asp-validation-for="Input.LocationId"
                      class="field-error">
                </span>

            </div>

            <div class="crud-field">

                <label asp-for="Input.Date">
                    Date
                </label>

                <input asp-for="Input.Date"
                       type="date" />

                <span asp-validation-for="Input.Date"
                      class="field-error">
                </span>

            </div>

            <div class="crud-field">

                <label asp-for="Input.Time">
                    Time
                </label>

                <input asp-for="Input.Time"
                       type="time" />

                <span asp-validation-for="Input.Time"
                      class="field-error">
                </span>

            </div>

            <div class="crud-field check">

                <input asp-for="Input.Completed"
                       type="checkbox" />

                <label asp-for="Input.Completed">
                    Mark as completed
                </label>

            </div>

            <div class="crud-field wide">

                <label asp-for="Input.Notes">
                    Notes
                </label>

                <textarea asp-for="Input.Notes"
                          rows="4"
                          placeholder="Enter cleaning task notes"></textarea>

                <span asp-validation-for="Input.Notes"
                      class="field-error">
                </span>

            </div>

        </div>

        <div class="crud-buttons">

            <button type="submit"
                    class="btn btn-primary">
                @(Model.EditId.HasValue ? "Update Task" : "Create Task")
            </button>

            @if (Model.EditId.HasValue)
            {
                <a class="btn btn-muted"
                   asp-page="/Admin/AdminTasks"
                   asp-route-Search="@Model.Search">
                    Cancel
                </a>
            }

        </div>

    </form>

</div>`

</div>

@section Scripts { <partial name="_ValidationScriptsPartial" />
}
