@page "/AdminProperties"
@model Arniston_Letting_Front.Pages.Admin.AdminPropertiesModel

@{
ViewData["Title"] = "Properties";
}

<div class="crud-page">
<div class="crud-header">

    <div>
        <div class="crud-title">Properties</div>
        <div class="crud-subtitle">Manage properties, owners, rates and amenities</div>
    </div>

    <form method="get"
          class="crud-search">

        <input type="text"
               name="Search"
               value="@Model.Search"
               placeholder="Search properties..." />

        <button type="submit"
                class="btn btn-primary">
            Search
        </button>

        @if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            <a class="btn btn-muted"
               asp-page="/Admin/AdminProperties">
                Clear
            </a>
        }

    </form>

</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-success">
        @Model.Message
    </div>
}

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-error">
        @Model.Error
    </div>
}

<div class="crud-card">

    <div class="crud-card-header">

        <div>
            <h2>Property List</h2>
            <span>Managed properties and current occupancy information</span>
        </div>

    </div>

    <div class="crud-table-wrap">

        <table class="crud-table">

            <thead>
                <tr>
                    <th class="col-id">ID</th>
                    <th>Property</th>
                    <th>Owner</th>
                    <th>Bedrooms</th>
                    <th>Sleeps</th>
                    <th class="col-rate">Rate / night</th>
                    <th>Occupancy</th>
                    <th class="col-actions">Actions</th>
                </tr>
            </thead>

            <tbody>

                @if (Model.Items.Any())
                {
                    foreach (var item in Model.Items)
                    {
                        <tr class="@(Model.EditId == item.PropertyId ? "selected" : "")">

                            <td class="booking-id">
                                @item.PropertyId
                            </td>

                            <td class="booking-property">
                                @item.PropertyName
                            </td>

                            <td>
                                @item.OwnerName
                            </td>

                            <td>
                                @item.Bedrooms
                            </td>

                            <td>
                                @item.Sleeps
                            </td>

                            <td class="booking-rate">
                                R @item.RatePerNight.ToString("N2")
                            </td>

                            <td>

                                @if (item.Occupied)
                                {
                                    <span class="dashboard-status status-pending">
                                        Occupied
                                    </span>
                                }
                                else
                                {
                                    <span class="dashboard-status status-completed">
                                        Available
                                    </span>
                                }

                            </td>

                            <td>

                                <div class="crud-actions">

                                    <a class="btn btn-small btn-primary"
                                       asp-page="/Admin/AdminProperties"
                                       asp-route-EditId="@item.PropertyId"
                                       asp-route-Search="@Model.Search">
                                        Edit
                                    </a>

                                    <form method="post"
                                          asp-page-handler="Delete"
                                          asp-route-id="@item.PropertyId"
                                          asp-route-Search="@Model.Search"
                                          onsubmit="return confirm('Delete this property?');">

                                        <button type="submit"
                                                class="btn btn-small btn-danger">
                                            Delete
                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8"
                            class="empty-state">
                            No properties found.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

<div class="crud-panel">

    <div class="crud-panel-header">

        <div>

            <h2>
                @(Model.EditId.HasValue
                    ? $"Edit property #{Model.EditId}"
                    : "Add new property")
            </h2>

            <span>
                @(Model.EditId.HasValue
                    ? "Update the property information below"
                    : "Add a new property to the letting system")
            </span>

        </div>

    </div>

    <form method="post"
          asp-page-handler="Save"
          asp-route-Search="@Model.Search">

        <input type="hidden"
               name="EditId"
               value="@Model.EditId" />

        <div asp-validation-summary="ModelOnly"
             class="field-error">
        </div>

        <div class="crud-form">

            <div class="crud-field">

                <label asp-for="Input.PropertyName">
                    Property name
                </label>

                <input asp-for="Input.PropertyName"
                       type="text"
                       placeholder="Enter property name" />

                <span asp-validation-for="Input.PropertyName"
                      class="field-error">
                </span>

            </div>

            <div class="crud-field">

                <label asp-for="Input.Address">
                    Address
                </label>

                <input asp-for="Input.Address"
                       type="text"
                       placeholder="Enter property address" />

                <span asp-validation-for="Input.Address"
                      class="field-error">
                </span>

            </div>

            <div class="crud-field">

                <label asp-for="Input.OwnerId">
                    Owner
                </label>

                <select asp-for="Input.OwnerId"
                        asp-items="Model.OwnerOptions">

                    <option value="">
                        -- Select owner --
                    </option>

                </select>

                <span asp-validation-for="Input.OwnerId"
                      class="field-error">
                </span>

            </div>

            <div class="crud-field">

                <label asp-for="Input.Bedrooms">
                    Bedrooms
                </label>

                <input asp-for="Input.Bedrooms"
                       type="number"
                       min="0"
                       placeholder="0" />

                <span asp-validation-for="Input.Bedrooms"
                      class="field-error">
                </span>

            </div>

            <div class="crud-field">

                <label asp-for="Input.Sleeps">
                    Sleeps
                </label>

                <input asp-for="Input.Sleeps"
                       type="number"
                       min="0"
                       placeholder="0" />

                <span asp-validation-for="Input.Sleeps"
                      class="field-error">
                </span>

            </div>

            <div class="crud-field">

                <label asp-for="Input.RatePerNight">
                    Rate per night (R)
                </label>

                <input asp-for="Input.RatePerNight"
                       type="number"
                       step="0.01"
                       min="0"
                       placeholder="0.00" />

                <span asp-validation-for="Input.RatePerNight"
                      class="field-error">
                </span>

            </div>

            <div class="crud-field check">

                <input asp-for="Input.Occupied"
                       type="checkbox" />

                <label asp-for="Input.Occupied">
                    Currently occupied
                </label>

            </div>

            <div class="crud-field">

                <label asp-for="Input.OccupiedUntil">
                    Occupied until
                </label>

                <input asp-for="Input.OccupiedUntil"
                       type="date" />

                <span asp-validation-for="Input.OccupiedUntil"
                      class="field-error">
                </span>

            </div>

            <div class="crud-field check">

                <input asp-for="Input.Parking"
                       type="checkbox" />

                <label asp-for="Input.Parking">
                    Parking available
                </label>

            </div>

            <div class="crud-field check">

                <input asp-for="Input.Pool"
                       type="checkbox" />

                <label asp-for="Input.Pool">
                    Swimming pool
                </label>

            </div>

            <div class="crud-field wide">

                <label asp-for="Input.Description">
                    Description
                </label>

                <textarea asp-for="Input.Description"
                          rows="4"
                          placeholder="Enter property description"></textarea>

                <span asp-validation-for="Input.Description"
                      class="field-error">
                </span>

            </div>

        </div>

        <div class="crud-buttons">

            <button type="submit"
                    class="btn btn-primary">
                @(Model.EditId.HasValue ? "Update Property" : "Create Property")
            </button>

            @if (Model.EditId.HasValue)
            {
                <a class="btn btn-muted"
                   asp-page="/Admin/AdminProperties"
                   asp-route-Search="@Model.Search">
                    Cancel
                </a>
            }

        </div>

    </form>

</div>

</div>

@section Scripts { <partial name="_ValidationScriptsPartial" />
}
