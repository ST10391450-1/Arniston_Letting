@page "/AdminReports"
@model Arniston_Letting_Front.Pages.Admin.AdminReportsModel

@{
ViewData["Title"] = "Reports";
}

<div class="crud-page">

<div class="crud-header">

    <div>
        <div class="crud-title">Reports</div>
        <div class="crud-subtitle">Manage generated reports and reporting activity</div>
    </div>

    <form method="get"
          class="crud-search">

        <input type="text"
               name="Search"
               value="@Model.Search"
               placeholder="Search reports..." />

        <button type="submit"
                class="btn btn-primary">
            Search
        </button>

        @if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            <a class="btn btn-muted"
               asp-page="/Admin/AdminReports">
                Clear
            </a>
        }

    </form>

</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-success">
        @Model.Message
    </div>
}

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-error">
        @Model.Error
    </div>
}

<div class="crud-card">

    <div class="crud-card-header">

        <div>
            <h2>Report List</h2>
            <span>Generated reports and their current status</span>
        </div>

    </div>

    <div class="crud-table-wrap">

        <table class="crud-table">

            <thead>
                <tr>
                    <th class="col-id">ID</th>
                    <th>Type</th>
                    <th>Date</th>
                    <th>Generated by</th>
                    <th>Status</th>
                    <th class="col-actions">Actions</th>
                </tr>
            </thead>

            <tbody>

                @if (Model.Items.Any())
                {
                    foreach (var item in Model.Items)
                    {
                        <tr class="@(Model.EditId == item.ReportId ? "selected" : "")">

                            <td class="booking-id">
                                @item.ReportId
                            </td>

                            <td class="booking-property">
                                @item.ReportType
                            </td>

                            <td>
                                @item.Date.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @item.GeneratedBy
                            </td>

                            <td>

                                @if (item.Status == "Completed" ||
                                     item.Status == "Generated")
                                {
                                    <span class="dashboard-status status-completed">
                                        @item.Status
                                    </span>
                                }
                                else if (item.Status == "Pending")
                                {
                                    <span class="dashboard-status status-pending">
                                        Pending
                                    </span>
                                }
                                else
                                {
                                    <span class="dashboard-status">
                                        @item.Status
                                    </span>
                                }

                            </td>

                            <td>

                                <div class="crud-actions">

                                    <a class="btn btn-small btn-primary"
                                       asp-page="/Admin/AdminReports"
                                       asp-route-EditId="@item.ReportId"
                                       asp-route-Search="@Model.Search">
                                        Edit
                                    </a>

                                    <form method="post"
                                          asp-page-handler="Generate"
                                          asp-route-id="@item.ReportId"
                                          asp-route-Search="@Model.Search">

                                        <button type="submit"
                                                class="btn btn-small">
                                            Generate
                                        </button>

                                    </form>

                                    <form method="post"
                                          asp-page-handler="Delete"
                                          asp-route-id="@item.ReportId"
                                          asp-route-Search="@Model.Search"
                                          onsubmit="return confirm('Delete this report?');">

                                        <button type="submit"
                                                class="btn btn-small btn-danger">
                                            Delete
                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6"
                            class="empty-state">
                            No reports found.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

<div class="crud-panel">

    <div class="crud-panel-header">

        <div>

            <h2>
                @(Model.EditId.HasValue
                    ? $"Edit report #{Model.EditId}"
                    : "Add new report")
            </h2>

            <span>
                @(Model.EditId.HasValue
                    ? "Update the report information below"
                    : "Create a new report record")
            </span>

        </div>

    </div>

    <form method="post"
          asp-page-handler="Save"
          asp-route-Search="@Model.Search">

        <input type="hidden"
               name="EditId"
               value="@Model.EditId" />

        <div asp-validation-summary="ModelOnly"
             class="field-error">
        </div>

        <div class="crud-form">

            <div class="crud-field">

                <label asp-for="Input.ReportType">
                    Report type
                </label>

                <select asp-for="Input.ReportType">

                    <option value="">
                        -- Select report type --
                    </option>

                    <option value="Bookings">
                        Bookings
                    </option>

                    <option value="Properties">
                        Properties
                    </option>

                    <option value="Owners">
                        Owners
                    </option>

                    <option value="Cleaning">
                        Cleaning
                    </option>

                    <option value="Breakages">
                        Breakages
                    </option>

                </select>

                <span asp-validation-for="Input.ReportType"
                      class="field-error">
                </span>

            </div>

            <div class="crud-field">

                <label asp-for="Input.Date">
                    Date
                </label>

                <input asp-for="Input.Date"
                       type="date" />

                <span asp-validation-for="Input.Date"
                      class="field-error">
                </span>

            </div>

            <div class="crud-field">

                <label asp-for="Input.GeneratedBy">
                    Generated by
                </label>

                <input asp-for="Input.GeneratedBy"
                       type="text"
                       placeholder="Enter name" />

                <span asp-validation-for="Input.GeneratedBy"
                      class="field-error">
                </span>

            </div>

            <div class="crud-field">

                <label asp-for="Input.Status">
                    Status
                </label>

                <select asp-for="Input.Status">

                    <option value="">
                        -- Select status --
                    </option>

                    <option value="Pending">
                        Pending
                    </option>

                    <option value="Completed">
                        Completed
                    </option>

                    <option value="Generated">
                        Generated
                    </option>

                </select>

                <span asp-validation-for="Input.Status"
                      class="field-error">
                </span>

            </div>

            <div class="crud-field wide">

                <label asp-for="Input.Description">
                    Description
                </label>

                <textarea asp-for="Input.Description"
                          rows="4"
                          placeholder="Enter report description"></textarea>

                <span asp-validation-for="Input.Description"
                      class="field-error">
                </span>

            </div>

        </div>

        <div class="crud-buttons">

            <button type="submit"
                    class="btn btn-primary">
                @(Model.EditId.HasValue ? "Update Report" : "Create Report")
            </button>

            @if (Model.EditId.HasValue)
            {
                <a class="btn btn-muted"
                   asp-page="/Admin/AdminReports"
                   asp-route-Search="@Model.Search">
                    Cancel
                </a>
            }

        </div>

    </form>

</div>

</div>

@section Scripts { <partial name="_ValidationScriptsPartial" />
}
