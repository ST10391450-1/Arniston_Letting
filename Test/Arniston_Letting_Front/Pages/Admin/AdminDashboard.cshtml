@page "/AdminDashboard"
@model Arniston_Letting_Front.Pages.Admin.AdminDashboardModel

@{
ViewData["Title"] = "Admin Dashboard";
}

<div class="dashboard-page">
@if (!Model.ApiAvailable)
{
    <div class="dashboard-alert">
        <div class="dashboard-alert-title">API Connection Error</div>
        <div class="dashboard-alert-text">
            The Arniston Letting API could not be reached. Check that the API is running
            and that <code>ApiSettings:BaseUrl</code> in appsettings.json is correct.
        </div>
    </div>
}

<div class="dashboard-header">

    <div>
        <h1>Admin Dashboard</h1>
        <p>Property management overview and current activity</p>
    </div>

    <div class="dashboard-date">
        <span>Today</span>
        <strong>@DateTime.Now.ToString("dd MMMM yyyy")</strong>
    </div>

</div>

<section class="dashboard-stats">

    <div class="dashboard-stat">
        <div class="stat-label">Total bookings</div>
        <div class="stat-value">@Model.Dashboard.TotalBookings</div>
        <div class="stat-description">All reservations</div>
    </div>

    <div class="dashboard-stat">
        <div class="stat-label">Properties</div>
        <div class="stat-value">@Model.Dashboard.TotalProperties</div>
        <div class="stat-description">Managed properties</div>
    </div>

    <div class="dashboard-stat">
        <div class="stat-label">Owners</div>
        <div class="stat-value">@Model.Dashboard.TotalOwners</div>
        <div class="stat-description">Property owners</div>
    </div>

    <div class="dashboard-stat">
        <div class="stat-label">Cleaners</div>
        <div class="stat-value">@Model.Dashboard.TotalCleaners</div>
        <div class="stat-description">Available staff</div>
    </div>

    <div class="dashboard-stat stat-warning">
        <div class="stat-label">Pending tasks</div>
        <div class="stat-value">@Model.Dashboard.PendingTasks</div>
        <div class="stat-description">Require attention</div>
    </div>

    <div class="dashboard-stat stat-danger">
        <div class="stat-label">Open breakages</div>
        <div class="stat-value">@Model.Dashboard.OpenBreakages</div>
        <div class="stat-description">Awaiting resolution</div>
    </div>

    <div class="dashboard-stat stat-notification">
        <div class="stat-label">Notifications</div>
        <div class="stat-value">@Model.Dashboard.PendingNotifications</div>
        <div class="stat-description">Pending notifications</div>
    </div>

</section>

<section class="dashboard-section">

    <div class="dashboard-section-header">
        <div>
            <h2>Upcoming bookings</h2>
            <p>Nearest confirmed reservations</p>
        </div>

        <a href="/AdminBookings"
           class="dashboard-link">
            View bookings
        </a>
    </div>

    <div class="dashboard-table-wrap">

        <table class="dashboard-table">

            <thead>
                <tr>
                    <th>Accommodation</th>
                    <th>Booker</th>
                    <th>Check in</th>
                    <th>Check out</th>
                    <th>Rate</th>
                </tr>
            </thead>

            <tbody>

                @if (Model.UpcomingBookings.Any())
                {
                    foreach (var booking in Model.UpcomingBookings)
                    {
                        <tr>

                            <td class="dashboard-primary">
                                @booking.PropertyName
                            </td>

                            <td>
                                @booking.BookerName
                            </td>

                            <td>
                                @booking.CheckIn.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @booking.CheckOut.ToString("dd MMM yyyy")
                            </td>

                            <td class="dashboard-rate">
                                R @booking.Rate.ToString("N2")
                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5"
                            class="dashboard-empty">
                            No upcoming confirmed bookings.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</section>

<section class="dashboard-columns">

    <div class="dashboard-section">

        <div class="dashboard-section-header">

            <div>
                <h2>Open breakages</h2>
                <p>Items requiring attention</p>
            </div>

            <a href="/AdminBreakages"
               class="dashboard-link">
                View all
            </a>

        </div>

        <div class="dashboard-table-wrap">

            <table class="dashboard-table">

                <thead>
                    <tr>
                        <th>Location</th>
                        <th>Reported by</th>
                        <th>Date</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.OpenBreakages.Any())
                    {
                        foreach (var breakage in Model.OpenBreakages)
                        {
                            <tr>

                                <td class="dashboard-primary">
                                    @breakage.LocationName
                                </td>

                                <td>
                                    @breakage.ReportedBy
                                </td>

                                <td>
                                    @breakage.Date.ToString("dd MMM yyyy")
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3"
                                class="dashboard-empty">
                                No open breakages.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    <div class="dashboard-section">

        <div class="dashboard-section-header">

            <div>
                <h2>Today's cleaning</h2>
                <p>Scheduled cleaning activity</p>
            </div>

            <a href="/AdminTasks"
               class="dashboard-link">
                View tasks
            </a>

        </div>

        <div class="dashboard-table-wrap">

            <table class="dashboard-table">

                <thead>
                    <tr>
                        <th>Location</th>
                        <th>Cleaner</th>
                        <th>Time</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.TodaysCleanings.Any())
                    {
                        foreach (var task in Model.TodaysCleanings)
                        {
                            <tr>

                                <td class="dashboard-primary">
                                    @task.LocationName
                                </td>

                                <td>
                                    @task.CleanerName
                                </td>

                                <td>
                                    @task.Time.ToString(@"hh\:mm")
                                </td>

                                <td>

                                    @if (task.Completed)
                                    {
                                        <span class="dashboard-status status-completed">
                                            Completed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="dashboard-status status-pending">
                                            Pending
                                        </span>
                                    }

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4"
                                class="dashboard-empty">
                                No cleaning tasks for today.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</section>
</div>
