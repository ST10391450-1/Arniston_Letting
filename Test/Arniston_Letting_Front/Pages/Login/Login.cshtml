@page "/Login"
@model Arniston_Letting_Front.Pages.Login.LoginModel

@{
    ViewData["Title"] = "Login";
    ViewData["NoNav"] = true;
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/login.css"
          asp-append-version="true" />
}

<div class="login-page">

    <div class="login-card">

        <div class="login-brand">
            <div class="brand-logo">
                <img src="~/Assests/icon.png" alt="Arniston Holiday Letting" />
            </div>

            <div class="login-brand-name">
                Arniston Holiday Letting
            </div>
        </div>

        <div class="login-heading">
            <h1>Login</h1>
            <p>Sign in to continue</p>
        </div>

        <form method="post">

            <div asp-validation-summary="All"
                 class="validation-summary">
            </div>

            <div class="form-group">

                <label asp-for="LoginRequest.Email">
                    Email
                </label>

                <input asp-for="LoginRequest.Email"
                       type="email"
                       placeholder="Enter your email"
                       autocomplete="email" />

                <span asp-validation-for="LoginRequest.Email"
                      class="field-error">
                </span>

            </div>

            <div class="form-group">

                <label asp-for="LoginRequest.Password">
                    Password
                </label>

                <input asp-for="LoginRequest.Password"
                       type="password"
                       placeholder="Enter your password"
                       autocomplete="current-password" />

                <span asp-validation-for="LoginRequest.Password"
                      class="field-error">
                </span>

            </div>

            <button type="submit"
                    class="login-button">
                Login
            </button>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
