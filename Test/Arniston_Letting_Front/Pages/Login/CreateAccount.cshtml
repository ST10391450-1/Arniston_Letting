@page "/CreateAccount"
@model Arniston_Letting_Front.Pages.CreateAccount.CreateAccountModel

@{
    ViewData["Title"] = "Create Account";
    ViewData["NoNav"] = true;
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/login.css"
          asp-append-version="true" />
}

<div class="login-container">

    <div class="login-card">

        <h1>Create Account</h1>

        <form method="post">

            <div asp-validation-summary="All"></div>

            <div class="form-group">

                <label asp-for="CreateAccountRequest.Email">
                    Email
                </label>

                <input asp-for="CreateAccountRequest.Email"
                       type="email"
                       placeholder="Enter your email" />

                <span asp-validation-for="CreateAccountRequest.Email"></span>

            </div>

            <div class="form-group">

                <label asp-for="CreateAccountRequest.Password">
                    Password
                </label>

                <input asp-for="CreateAccountRequest.Password"
                       type="password"
                       placeholder="Enter your password" />

                <span asp-validation-for="CreateAccountRequest.Password"></span>

            </div>

            <div class="form-group">

                <label asp-for="CreateAccountRequest.ConfirmPassword">
                    Confirm Password
                </label>

                <input asp-for="CreateAccountRequest.ConfirmPassword"
                       type="password"
                       placeholder="Confirm your password" />

                <span asp-validation-for="CreateAccountRequest.ConfirmPassword"></span>

            </div>

            <button type="submit"
                    class="login-button">
                Create Account
            </button>

        </form>

        <a href="/Login" class="create-account-button">
            Back to Login
        </a>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}